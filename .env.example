# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=fn_dev

# production enables Secure cookies and blocks the destructive seeders
APP_ENV=development
PORT=8000

# Required in production. Signs session cookies; the code used to ship a
# hardcoded key, so rotate this and never reuse the old one.
JWT_SECRET=

# Comma-separated browser origins allowed to call the API with credentials
CORS_ORIGINS=http://localhost:5173

# Only needed if the panel ever moves off the API's origin. Served under
# /admin on the same domain, the cookie is host-only and SameSite=Lax.
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax

# Where uploaded images are written. In production this MUST be a mounted
# volume, or every redeploy destroys the uploads. On the VPS the container gets
#   -v /srv/epweb-media:/app/static/images
# which is a 1 GB ext4 loopback image, so uploads can never fill the host disk.
UPLOAD_DIR=./static/images

# Refuse uploads past this many bytes in total, so the panel reports a full
# store instead of hitting ENOSPC. 900 MB leaves headroom under the 958 MB
# volume. Empty or 0 disables the check.
MEDIA_QUOTA_BYTES=943718400

# Destructive: TRUNCATEs categories and inserts demo articles. Never in prod.
SEED_SAMPLE_DATA=false

# Notification for new enquiries. If any of HOST/PORT/FROM/LEAD_NOTIFY_TO is
# empty the send is skipped and the lead is still stored: a missed notification
# beats a rejected customer. Recipients come from here, never from the form.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
LEAD_NOTIFY_TO=training@excellenceplus.id
